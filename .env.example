# ============================================================
# Configuration locale Snowsled v2
# Copiez ce fichier vers .env et renseignez vos valeurs.
# IMPORTANT : .env est dans .gitignore — ne jamais committer !
# ============================================================

# ── Compte Snowflake ─────────────────────────────────────────
SNOWFLAKE_ACCOUNT=<votre_compte>.us-east-1.aws
SNOWFLAKE_USER=<votre_utilisateur>
SNOWFLAKE_PASSWORD=<votre_mot_de_passe>

# ── Contexte par défaut ──────────────────────────────────────
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWSLED_V2     # Nom de l'app Native installée
SNOWFLAKE_SCHEMA=APP_SCHEMA

# ── Profil Snowflake CLI (alternative aux variables ci-dessus)
# Utilisé si SNOWFLAKE_PASSWORD n'est pas défini
SNOWFLAKE_CONNECTION=dsp_inno
